---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '@layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
// remarkPluginFrontmatter carries values set by remark plugins, e.g. minutesRead
// from src/plugin/remark-reading-time.mjs. They are not part of post.data.
const { Content, remarkPluginFrontmatter } = await render(post);
---
<BlogPost {...post.data} minutesRead={remarkPluginFrontmatter.minutesRead}>
	<Content />
</BlogPost>
